# Copy this file to .env and fill in what you need. Every service reads it.
# Values here are for local development. Never commit .env.

# --- Models -------------------------------------------------------------------
# gemini: real answers (needs GOOGLE_API_KEY from https://aistudio.google.com/apikey)
# offline: a rule-based stand-in so the whole system runs with no key (answers are crude)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=

# Two tiers: the mid model plans and verifies, the small model does most calls.
MODEL_MID=gemini-3.8-flash
MODEL_SMALL=gemini-3.5-flash-lite
MODEL_MID_FALLBACK=gemini-3.6-flash
MODEL_SMALL_FALLBACK=gemini-3.1-flash-lite
THINKING_LEVEL_MID=low
THINKING_LEVEL_SMALL=minimal
JUDGE_MODEL=gemini-3.6-flash

# gemini: gemini-embedding-001 at 768 dimensions. hash: offline, much weaker retrieval.
# Changing this means re-running `uv run mara ingest`.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# none | llm (an extra small-model call per search to rerank the top 20)
RERANKER=none

# --- Stores -------------------------------------------------------------------
APP_DB_URL=postgresql://mara:mara@localhost:5432/mara
WAREHOUSE_RO_URL=postgresql://agent_ro:agent_ro@localhost:5432/warehouse
WAREHOUSE_ADMIN_URL=postgresql://warehouse:warehouse@localhost:5432/warehouse
# A Qdrant server (docker compose up -d qdrant) or a folder for embedded mode,
# e.g. QDRANT_URL=data/generated/qdrant (no server needed, one process at a time).
QDRANT_URL=http://localhost:6333

# --- Identity -----------------------------------------------------------------
# The dev token service (apps/token-service). Point these at Keycloak to switch.
AUTH_ISSUER=http://token-service:8090
AUTH_TOKEN_URL=http://localhost:8090/token
AUTH_JWKS_URL=http://localhost:8090/jwks.json
ORCHESTRATOR_CLIENT_SECRET=dev-orchestrator-secret
EXECUTOR_CLIENT_SECRET=dev-executor-secret

# --- Web research agent (A2A) -------------------------------------------------
# auto: Claude Agent SDK if ANTHROPIC_API_KEY is set, else Gemini with Google
# Search grounding if GOOGLE_API_KEY is set, else a scripted stub.
RESEARCH_ENGINE=auto
ANTHROPIC_API_KEY=
RESEARCH_MODEL=gemini-3.8-flash
RESEARCH_MAX_TURNS=12
RESEARCH_MAX_BUDGET_USD=0.25
A2A_TIMEOUT_SECONDS=90

# --- Budgets per run ------------------------------------------------------------
BUDGET_MAX_USD=0.10
BUDGET_MAX_CALLS=24
BUDGET_MAX_SECONDS=120
MAX_PARALLEL_WORKERS=4
WORKER_TOOL_CALL_LIMIT=6

# --- Actions --------------------------------------------------------------------
# sandbox: issues and Slack posts go to the mock APIs (see data/generated/sandbox/)
# live: real GitHub / Slack / SMTP with the credentials below
ACTIONS_BACKEND=sandbox
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=

# --- Evals and tracing ------------------------------------------------------------
# Lets eval runs inject tool faults. Keep it false anywhere real.
ENABLE_FAULT_INJECTION=false
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=mara
# LangSmith tracing for every graph step and model call (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mara
# OpenTelemetry traces to Jaeger (docker compose --profile observability up)
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Misc -------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
